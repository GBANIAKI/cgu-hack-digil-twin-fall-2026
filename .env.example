# Copy to .env and fill in provider credentials. Never commit .env.
PERSONATWIN_DB=personatwin.db

# Provider A (OpenAI-compatible chat completions API)
LLM_A_BASE_URL=https://api.openai.com/v1
LLM_A_API_KEY=
LLM_A_MODEL=

# Provider B (can be a different vendor or a compatible local endpoint)
LLM_B_BASE_URL=https://api.openai.com/v1
LLM_B_API_KEY=
LLM_B_MODEL=

# Separate judge model is recommended to reduce confirmation bias
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=
JUDGE_MODEL=
LLM_TIMEOUT=60
